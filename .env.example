# 复制本文件为 .env 后再启动：cp .env.example .env
# .env 已在 .gitignore 中，任何密钥都不要写进仓库。

# ---------- 必填：数据库账号 ----------
POSTGRES_USER=kaohe
POSTGRES_PASSWORD=please-change-this-password
POSTGRES_DB=kaohe

# ---------- 可选：宿主机访问端口 ----------
# 只暴露 web 一个端口，容器之间一律走 compose 内网。
# 若 8080 被占用，改这里即可；改完浏览器地址随之变化，容器内部不受影响。
WEB_PORT=8080

# ---------- 应用配置（一般无需修改） ----------
# 单文件上传上限，默认 20 MiB。超限返回 413。
MAX_UPLOAD_BYTES=20971520

# 语义检索的余弦相似度下限（0~1）。低于它的片段不展示。
# 向量检索永远会返回「最像的几条」，哪怕它们其实都不相关；
# 这个下限是把「没有相关内容」变成空结果的开关。
#
# 0.5 是按当前使用的 bge-small-zh-v1.5 在验收语料上标定出来的：
# 确实相关的片段文档级相似度都在 0.60 以上，而语料里没有对应内容时
# 最像的几条落在 0.44~0.47，0.5 取的是这段空档的中点。
# 换向量模型后必须重新标定，否则会出现「怎么搜都是空」或「不相关也返回一堆」。
SEMANTIC_MIN_SCORE=0.5

# ---------- 可选：日志 ----------
# 每个角色写一个文件，绑定挂载在仓库下的 ./logs：
#   api.log / worker.log / migrate.log
# 之所以按角色分开，是因为 api 与 worker 是两个独立容器，
# 而 lumberjack 的轮转（重命名 + 新建）不做多进程同步 ——
# 两个进程写同一个文件会交替丢日志、轮转互相踩。
#
# 直观看文件：  docker compose exec api tail -f /data/logs/api.log
# 看 stdout：  docker compose logs --tail=100 api
LOG_LEVEL=info
LOG_CONSOLE_FORMAT=console
LOG_DIR=/data/logs

# LOG_DIR 是容器内的路径，一般不用改；LOG_HOST_DIR 是它映射到宿主机的哪个目录。
# 默认 ./logs，想换个地方（比如把日志挪到大盘）改这个即可。
# 同时跑两套栈时**必须**给其中一套换个目录（见 scripts/clean_start_smoke.py）：
# 文件名按角色固定，两个 api 写同一个 api.log 会让轮转互相踩。
#
# 清空日志要在容器停掉之后做（docker compose stop api worker && rm logs/*.log）：
# 容器还在跑时从宿主机截断一个绑定挂载的文件，会让它继续按旧偏移追加，
# 中间留下一段 NUL 填充，日志文件从此不干净。
LOG_HOST_DIR=./logs

# 轮转：单文件超过 32MiB 就切一个，最多留 5 份、30 天。
# LOG_COMPRESS=true 会让轮转出来的旧文件变成 .gz —— 那样得用 zcat 而不是 grep 看，
# 所以默认关闭。0 表示该项不限制（LOG_MAX_SIZE_MB 例外，它必须为正）。
LOG_MAX_SIZE_MB=32
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=false

# 「多慢算慢」。超出的请求/任务会被标记 slow=true，并且请求的日志等级升到 warn ——
# 这样 LOG_LEVEL=warn 时留下的正好全是异常，慢请求不会被淹没在正常行里。
#
# 这两个值按实测标定：本机接口请求（healthz / 列表 / 关键词检索 / 语义检索）
# 绝大多数在 45ms 以内，冷启动那一次 189ms，所以 500ms 大约是热态峰值的十倍；
# 索引任务在验收语料上是 16ms~585ms，唯一一次 15.41s 出自一个 440KB 的 Markdown，
# 所以 5s 正好能把那一个异常挑出来。
SLOW_REQUEST_MS=500
SLOW_TASK_MS=5000
