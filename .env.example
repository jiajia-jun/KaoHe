# 复制本文件为 .env 后再启动：cp .env.example .env
# .env 已在 .gitignore 中，任何密钥都不要写进仓库。

# ---------- 必填：数据库账号 ----------
POSTGRES_USER=kaohe
POSTGRES_PASSWORD=please-change-this-password
POSTGRES_DB=kaohe

# ---------- 可选：宿主机访问端口 ----------
# 只暴露 web 一个端口，容器之间一律走 compose 内网。
# 若 8080 被占用，改这里即可；改完浏览器地址随之变化，容器内部不受影响。
WEB_PORT=8080

# ---------- 应用配置（一般无需修改） ----------
# 单文件上传上限，默认 20 MiB。超限返回 413。
MAX_UPLOAD_BYTES=20971520
