# 复制本文件为 .env 后再启动：cp .env.example .env
# .env 已在 .gitignore 中，任何密钥都不要写进仓库。

# ---------- 必填：数据库账号 ----------
POSTGRES_USER=kaohe
POSTGRES_PASSWORD=please-change-this-password
POSTGRES_DB=kaohe

# ---------- 可选：宿主机访问端口 ----------
# 只暴露 web 一个端口，容器之间一律走 compose 内网。
# 若 8080 被占用，改这里即可；改完浏览器地址随之变化，容器内部不受影响。
WEB_PORT=8080

# ---------- 应用配置（一般无需修改） ----------
# 单文件上传上限，默认 20 MiB。超限返回 413。
MAX_UPLOAD_BYTES=20971520

# 语义检索的余弦相似度下限（0~1）。低于它的片段不展示。
# 向量检索永远会返回「最像的几条」，哪怕它们其实都不相关；
# 这个下限是把「没有相关内容」变成空结果的开关。
#
# 0.5 是按当前使用的 bge-small-zh-v1.5 在验收语料上标定出来的：
# 确实相关的片段文档级相似度都在 0.60 以上，而语料里没有对应内容时
# 最像的几条落在 0.44~0.47，0.5 取的是这段空档的中点。
# 换向量模型后必须重新标定，否则会出现「怎么搜都是空」或「不相关也返回一堆」。
SEMANTIC_MIN_SCORE=0.5
