# 出题方题面材料（要求 PNG 与早期草稿），不属于交付物
/target/

# 环境变量与密钥：仓库内只允许存在 .env.example
.env
.env.*
!.env.example

# 前端
node_modules/
dist/
web/node_modules/
web/dist/

# 端到端测试产物（截图、trace、报告都是本地排障用，不入库）
web/test-results/
web/playwright-report/

# Go
*.exe
*.test
*.out
/bin/
/tmp/

# 验收脚本是 Python，跑过就会留下字节码缓存
__pycache__/
*.py[cod]

# 持久化演练的中间快照：内容是「当时那台机器上的数据」，不该进仓库
.persistence-snapshot.json
docs/semantic-examples.json

# 容器持久化数据（运行期由 Docker 具名卷承载，此处仅防本地直跑残留）
/data/
/uploads/

# 编辑器与系统
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
